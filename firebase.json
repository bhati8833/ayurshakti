{
  "hosting": {
    "public": "out",
    "cleanUrls": true,
    "trailingSlash": false,
    "redirects": [
      {
        "source": "/robot.txt",
        "destination": "/robots.txt",
        "type": 301
      },
      {
        "source": "/robot",
        "destination": "/robots.txt",
        "type": 301
      }
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ]
  }
}
